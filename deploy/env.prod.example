# Production environment template.
#
# On the target host:
#
#   cp deploy/env.prod.example .env.prod
#   chmod 600 .env.prod
#   $EDITOR .env.prod
#
# Compose must be told which file to read, because the default `.env` is the
# development one:
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# `.gitignore` covers `.env` and `.env.*`, so a filled copy is never committed.


# ---------------------------------------------------------------------------
# REQUIRED — the stack refuses to start without these
# ---------------------------------------------------------------------------

# Which images to run. Docker Hub requires the first path segment to be the account.
REGISTRY=urgosxd7
VERSION=0.1.0

# Database password. Applied on the volume's FIRST initdb ONLY: changing it later
# leaves Postgres holding the old password and the server unable to connect.
# Either set it once on a fresh volume, or run
#   ALTER USER agentdocumentor WITH PASSWORD '...'
# inside the container.
#
# Use HEX ONLY (openssl rand -hex 24). This value is interpolated straight into
# DATABASE_URL, and a password containing @ : / # ? would silently break that URL
# into a different host and port — measured, not assumed.
POSTGRES_PASSWORD=CHANGE_ME_run_openssl_rand_hex_24


# ---------------------------------------------------------------------------
# REQUIRED in practice — the server starts without it, then every turn fails with
# "No API key found for the selected model"
# ---------------------------------------------------------------------------

CHAT_API_KEY=CHANGE_ME


# ---------------------------------------------------------------------------
# Provider. Defaults match the development setup; change only if you change plans.
# ---------------------------------------------------------------------------

CHAT_PROVIDER=synthetic
CHAT_MODEL=syn:large:text
CHAT_API=openai-completions
CHAT_BASE_URL=https://api.synthetic.new/openai/v1


# ---------------------------------------------------------------------------
# Identity. READ THIS BEFORE EXPOSING THE STACK.
#
# The default is `password`: every person signs in with their own user and password, and
# the server keeps an `HttpOnly` session cookie. There is no secret in the URL, so a link
# cannot name anybody — what a link chooses is the Stack:
#
#   https://<host>/?stackId=<stack-id>
#
# Hand that out, tell the person which account is theirs, and let them sign in with their
# password. `?user=` and `?token=` are ignored: they carry no identity any more.
#
# The two accounts a fresh database gets are `alice` and `bob`. Set their passwords here,
# before the first boot, so nothing has to be read back from a log:
#
#   DEFAULT_USERS=alice:<password>,bob:<password>
#
# Password rules: 8 to 200 characters, and both halves of every entry are trimmed, so a
# password cannot begin or end with whitespace and a comma ends the entry. A malformed
# value STOPS the boot, naming the offending entry, instead of seeding half a deployment.
#
# With DEFAULT_USERS unset the two accounts are created anyway, each with a generated
# password printed ONCE in the server log at that first boot:
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml logs server |
#     grep 'generated password'
#
# That makes the log stream sensitive exactly once, so capture the line and store it with
# the rest of the deployment secrets. Every later boot prints the account names only, and
# a changed DEFAULT_USERS never rewrites an existing account: seeding cannot reset the
# password of somebody who is already using one. To give out a new account, sign in and
# `POST /api/users` with {user, password, displayName?} — everyone has the same
# permissions, so any signed-in person can create one.
#
# LEGACY MODES. `open`, `shared-token` and `roster` still work, and exist for the test
# suites and for a deployment that deliberately has no accounts. `open` means the
# `x-user-id` header IS the identity, with NO secret behind it: anyone who can reach the
# server becomes whoever they type, with no revocation. Only choose it behind TLS and
# network restrictions, and say so out loud. `roster` restores one secret per person and
# is the only legacy mode that resists impersonation; its roster is one line in
# `.chat-users`, next to this compose file on the target host, mounted read-only into the
# server container and read once at boot. That mode's tokens are NOT set in this file:
#
#   printf '%s\n' "alice:$(openssl rand -hex 16),bob:$(openssl rand -hex 16)" > .chat-users
#   chmod 600 .chat-users
#
# CHAT_USERS stays empty here on purpose, and is deprecated: it is read only by the legacy
# roster mode, and setting it in this file would put the tokens where they are copied
# around and interpolated. It exists only so an orchestrator secret can override the
# mounted file.
# ---------------------------------------------------------------------------

AUTH_MODE=password
# Placeholders: replace both values before the first boot.
DEFAULT_USERS=alice:<password>,bob:<password>
# CHAT_USERS=


# ---------------------------------------------------------------------------
# External ingest service. Optional: with an empty address the ingest routes answer
# 503 instead of pretending to be fine.
#
# INGEST_API_BASE_URL is an ORIGIN this server can reach.
# PUBLIC_BASE_URL is an origin the INGEST SERVICE reaches THIS server at. It is
# handed out as a capability URL, so localhost or the browser's origin would name
# the wrong process. Empty keeps uploads working but disables ingest-by-document.
# ---------------------------------------------------------------------------

INGEST_API_BASE_URL=
INGEST_API_TIMEOUT_MS=10000
PUBLIC_BASE_URL=http://server:8080

# Deadline for ONE MCP tool request, in milliseconds. The MCP client library's own
# default is 30 s, measured too short for `query_wiki` on a large Stack. A value that
# is not a positive number FAILS the boot instead of falling back, and the effective
# value is reported once in the startup log as "mcp request timeout".
MCP_REQUEST_TIMEOUT_MS=120000

# The same origin's MCP endpoint (…:4173/mcp). The server provisions it into every
# account's `tenant_mcp` row at boot and into each new account created by
# `POST /api/users`, so nobody has to run a script after adding a user. Empty disables
# automatic provisioning. Must be a literal address the hub bound, not a DNS name:
# the hub validates the `Host` header.
MCP_SERVER_URL=
# Every account gets the same grant. `false` is the shipped role's read-only list
# (12 tools). `true` also grants the write tools the host publishes: ingest_source,
# compile_wiki, export_okf, run_eval and ingest_job_delete.
MCP_GRANT_ALL_TOOLS=false


# ---------------------------------------------------------------------------
# What the model may do. AGENT_BASH=true hands the model everything the process can
# reach, including the provider key stored one directory above the workspace.
# ---------------------------------------------------------------------------

AGENT_READ_TOOLS=true
AGENT_SKILLS=true
AGENT_BASH=false
AGENT_WRITES=false



# ---------------------------------------------------------------------------
# Model limits and logging. These already have defaults in the compose file; they
# are listed so a tuning change is a one-line edit instead of a file hunt.
# ---------------------------------------------------------------------------

CHAT_CONTEXT_WINDOW=524288
CHAT_MAX_TOKENS=65536
CHAT_REASONING=true
CHAT_THINKING_LEVEL=medium
LOG_LEVEL=info
