# Production environment template.
#
# On the target host:
#
#   cp deploy/env.prod.example .env.prod
#   chmod 600 .env.prod
#   $EDITOR .env.prod
#
# Compose must be told which file to read, because the default `.env` is the
# development one:
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# `.gitignore` covers `.env` and `.env.*`, so a filled copy is never committed.


# ---------------------------------------------------------------------------
# REQUIRED — the stack refuses to start without these
# ---------------------------------------------------------------------------

# Which images to run. Docker Hub requires the first path segment to be the account.
REGISTRY=urgosxd7
VERSION=0.1.0

# Database password. Applied on the volume's FIRST initdb ONLY: changing it later
# leaves Postgres holding the old password and the server unable to connect.
# Either set it once on a fresh volume, or run
#   ALTER USER agentdocumentor WITH PASSWORD '...'
# inside the container.
#
# Use HEX ONLY (openssl rand -hex 24). This value is interpolated straight into
# DATABASE_URL, and a password containing @ : / # ? would silently break that URL
# into a different host and port — measured, not assumed.
POSTGRES_PASSWORD=CHANGE_ME_run_openssl_rand_hex_24


# ---------------------------------------------------------------------------
# REQUIRED in practice — the server starts without it, then every turn fails with
# "No API key found for the selected model"
# ---------------------------------------------------------------------------

CHAT_API_KEY=CHANGE_ME


# ---------------------------------------------------------------------------
# Provider. Defaults match the development setup; change only if you change plans.
# ---------------------------------------------------------------------------

CHAT_PROVIDER=synthetic
CHAT_MODEL=syn:large:text
CHAT_API=openai-completions
CHAT_BASE_URL=https://api.synthetic.new/openai/v1


# ---------------------------------------------------------------------------
# Identity. READ THIS BEFORE EXPOSING THE STACK.
#
# open   -> the name in the link IS the identity, and there is NO secret behind it.
#           Anyone who can reach the server becomes whoever they type. No revocation.
# roster -> per-user tokens (id:token, tokens of at least 16 characters). The only
#           mode that refuses a claimed name not matching the token.
#
# Switching is these two lines and nothing else:
#   AUTH_MODE=roster
#   CHAT_USERS=alice:<24 hex>,bob:<24 hex>
# ---------------------------------------------------------------------------

AUTH_MODE=open
# CHAT_USERS=


# ---------------------------------------------------------------------------
# External ingest service. Optional: with an empty address the ingest routes answer
# 503 instead of pretending to be fine.
#
# INGEST_API_BASE_URL is an ORIGIN this server can reach.
# PUBLIC_BASE_URL is an origin the INGEST SERVICE reaches THIS server at. It is
# handed out as a capability URL, so localhost or the browser's origin would name
# the wrong process. Empty keeps uploads working but disables ingest-by-document.
# ---------------------------------------------------------------------------

INGEST_API_BASE_URL=
INGEST_API_TIMEOUT_MS=10000
PUBLIC_BASE_URL=http://server:8080


# ---------------------------------------------------------------------------
# What the model may do. AGENT_BASH=true hands the model everything the process can
# reach, including the provider key stored one directory above the workspace.
# ---------------------------------------------------------------------------

AGENT_READ_TOOLS=true
AGENT_SKILLS=true
AGENT_BASH=false
AGENT_WRITES=false


# ---------------------------------------------------------------------------
# Model limits and logging. These already have defaults in the compose file; they
# are listed so a tuning change is a one-line edit instead of a file hunt.
# ---------------------------------------------------------------------------

CHAT_CONTEXT_WINDOW=524288
CHAT_MAX_TOKENS=65536
CHAT_REASONING=true
CHAT_THINKING_LEVEL=medium
LOG_LEVEL=info
